<title>NSL Enterprises | Solar Solutions & Support</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:Arial,sans-serif;background:#f4f8ff;color:#172b46}
:root{--blue:#0876df;--dark:#062b59;--light:#eaf4ff}
header{background:#062b59;color:white;padding:17px 6%;display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap}
.logo{font-size:23px;font-weight:900;letter-spacing:1px}
.logo span{color:#50b9ff}
nav{display:flex;gap:18px;flex-wrap:wrap}
nav a{color:white;text-decoration:none;font-size:14px}
.hero{background:linear-gradient(120deg,#052956,#0878df);color:white;padding:85px 7%;text-align:center}
.hero .tag{background:#ffffff25;padding:9px 16px;border-radius:30px;font-size:13px}
.hero h1{font-size:clamp(32px,6vw,55px);margin:25px 0 15px}
.hero p{max-width:680px;margin:auto;line-height:1.8;color:#e4f2ff}
.btn{display:inline-block;padding:14px 23px;border-radius:9px;text-decoration:none;font-weight:bold;margin:15px 5px;background:#fff;color:#0756a7}
.btn.blue{background:#08a0e9;color:white}
.container{max-width:1100px;margin:auto;padding:48px 18px}
.heading{text-align:center;margin-bottom:28px}
.heading h2{font-size:29px;color:var(--dark);margin-bottom:10px}
.heading p{color:#64748b;line-height:1.6}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
.card{background:white;padding:25px;border-radius:15px;box-shadow:0 5px 22px #153f7010;border:1px solid #e0eaf6}
.card .symbol{font-size:35px;margin-bottom:14px}
.card h3{color:#07549b;margin-bottom:10px}
.card p{color:#63748b;line-height:1.7;font-size:14px}
.form-section{background:white;border-radius:18px;padding:28px;box-shadow:0 8px 30px #153f7010}
label{display:block;font-weight:bold;font-size:14px;margin:16px 0 7px}
input,select,textarea{width:100%;padding:13px;border:1px solid #cedbea;border-radius:8px;font-size:15px;background:#fff}
textarea{height:110px;resize:vertical}
input:focus,select:focus,textarea:focus{outline:2px solid #a5d2ff}
.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.problem-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px;margin-top:10px}
.problem-list label{margin:0;padding:12px;border:1px solid #dce7f4;border-radius:9px;font-weight:normal}
.problem-list input{width:auto;margin-right:8px}
.submit{width:100%;background:#0876df;color:white;border:0;padding:16px;border-radius:9px;font-size:16px;font-weight:bold;margin-top:22px}
.contact{background:#e7f3ff;text-align:center;border-radius:17px;padding:35px}
.contact h2{color:#073b78;margin-bottom:12px}
.contact p{line-height:1.8;color:#536a84}
.trust{border:1px solid #dce7f4;background:white;border-radius:15px;padding:25px;text-align:center}
.inactive{display:inline-block;background:#fff0dc;color:#955300;padding:7px 14px;border-radius:20px;font-size:12px;font-weight:bold;margin-top:12px}
footer{background:#05264e;color:white;text-align:center;padding:30px 15px;line-height:2}
footer a{color:#9dd7ff;text-decoration:none}
.float{position:fixed;bottom:18px;right:15px;background:#16a34a;color:white;padding:14px 18px;border-radius:40px;text-decoration:none;font-weight:bold;box-shadow:0 5px 20px #0003;z-index:10}
@media(max-width:600px){header{justify-content:center;text-align:center}nav{justify-content:center}.hero{padding:60px 18px}.form-section{padding:18px}}
</style>
</head>
<body>

<header>
<div class="logo">NSL <span>ENTERPRISES</span></div>
<nav>
<a href="#home">Home</a>
<a href="#services">Services</a>
