<span class="inactive">DONATION COLLECTION NOT ACTIVE</span>
</div>
</section>

<footer>
<strong>NSL ENTERPRISES</strong><br>
Solar Service • Customer Care<br>
Phone: 8700784156<br>
<a href="https://wa.me/918700784156">WhatsApp Customer Support</a><br>
© 2026 NSL Enterprises. All Rights Reserved.
</footer>

<a class="float" href="https://wa.me/918700784156">WhatsApp</a>

<script>
const BUSINESS_WHATSAPP = "918700784156";

document.getElementById("complaintForm").addEventListener("submit", function(e){
e.preventDefault();

const problems = [...document.querySelectorAll('input[name="problem"]:checked')]
.map(item => item.value);

if(problems.length === 0){
alert("Kripya kam se kam ek complaint type select karein.");
return;
}

const message = `NSL ENTERPRISES - NEW CUSTOMER COMPLAINT

Customer: ${document.getElementById("customer").value}
Mobile: ${document.getElementById("mobile").value}
City: ${document.getElementById("city").value}
Address: ${document.getElementById("address").value}
Product: ${document.getElementById("product").value}
Problems: ${problems.join(", ")}
Details: ${document.getElementById("details").value}`;

const url = "https://wa.me/" + BUSINESS_WHATSAPP + "?text=" + encodeURIComponent(message);
window.location.href = url;
});
</script>
</body>
</html>
